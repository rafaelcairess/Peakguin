; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Game"
run/main_scene="res://ui/main_menu/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

CheckpointManager="*res://scripts/managers/checkpoint_manager.gd"
CollectiblesManager="*res://scripts/managers/collectibles_manager.gd"
MusicManager="*res://scripts/managers/music_manager.gd"
PauseMenu="*res://ui/pause_menu/pause_menu.tscn"
UIManager="*res://scripts/managers/ui_manager.gd"
RunTimer="*uid://cgb742cqpxu3h"

[display]

window/size/viewport_width=288
window/size/viewport_height=208
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="Game"

[global_group]

Player=""
Enemies=""
LethalArea=""
Water=""
Checkpoint=""
GrassSurface=""
Lava=""
InstantDeath=""
Pickups=""

[gui]

theme/custom="res://themes/game_theme.tres"

